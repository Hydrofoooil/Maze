<?xml version="1.0"?>
<!--
  5-DOF manipulator URDF generated from the supplied homogeneous transforms.

  Source matrix distances are in millimeters. URDF convention is meters, so all
  xyz values below are converted by 0.001.

  Visual meshes were split from the SolidWorks STEP assembly and stored in mm,
  so each mesh uses scale="0.001 0.001 0.001".

  Rotation decomposition used here:
    T_i_(i+1) = origin(xyz, rpy at theta_i = 0) * R_axis(theta_i)
  where URDF applies the joint rotation after the fixed origin transform.
-->
<robot name="five_dof_arm">
  <material name="light_gray">
    <color rgba="0.78 0.80 0.82 1.0"/>
  </material>
  <material name="dark_gray">
    <color rgba="0.25 0.27 0.30 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.12 0.36 0.80 1.0"/>
  </material>
  <material name="nib_red">
    <color rgba="0.90 0.10 0.10 1.0"/>
  </material>
  <material name="tail_green">
    <color rgba="0.10 0.80 0.20 1.0"/>
  </material>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/link_1.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="link_2">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/link_2.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <link name="link_3">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/link_3.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="link_4">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/link_4.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="light_gray"/>
    </visual>
  </link>

  <link name="link_5">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/link_5.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="blue"/>
    </visual>
  </link>

  <link name="pen_tip"/>

  <!-- 笔尖/笔尾标记: 坐标=arm_kinematics 反射后的 _NIB/_TAIL(link_5 局部系), 便于仿真核对 -->
  <link name="nib_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.006"/></geometry>
      <material name="nib_red"/>
    </visual>
  </link>
  <link name="tail_marker">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><sphere radius="0.006"/></geometry>
      <material name="tail_green"/>
    </visual>
  </link>

  <joint name="nib_marker_fixed" type="fixed">
    <parent link="link_5"/>
    <child link="nib_marker"/>
    <origin xyz="0.04473864 -0.07941421 0.030" rpy="0 0 0"/>
  </joint>
  <joint name="tail_marker_fixed" type="fixed">
    <parent link="link_5"/>
    <child link="tail_marker"/>
    <origin xyz="0.02646136 0.03921421 0.030" rpy="0 0 0"/>
  </joint>

  <!-- 真机=原URDF建模关于XZ平面(Y->-Y)的镜像; 全链已做Y反射使其忠实描述真机 -->
  <!-- ^0T_1: xyz=[0,0,49.3]mm, axis 反射后翻号 -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.0493" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159265359" upper="3.14159265359" effort="10" velocity="2"/>
  </joint>

  <!-- ^1T_2: xyz=[0,0,33.5]mm, rpy(pi/2,0,0)->(-pi/2,0,0), axis 翻号 -->
  <joint name="joint_2" type="revolute">
    <parent link="link_1"/>
    <child link="link_2"/>
    <origin xyz="0 0 0.0335" rpy="-1.57079632679 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="10" velocity="2"/>
  </joint>

  <!-- ^2T_3: xyz=[35.64,-230.02,0]mm (y反射), axis 翻号 -->
  <joint name="joint_3" type="revolute">
    <parent link="link_2"/>
    <child link="link_3"/>
    <origin xyz="0.03564 -0.23002 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="10" velocity="2"/>
  </joint>

  <!-- ^3T_4: xyz=[241.64,0,0]mm, rpy(0,-pi/2,pi)->(0,-pi/2,-pi), axis 翻号 -->
  <joint name="joint_4" type="revolute">
    <parent link="link_3"/>
    <child link="link_4"/>
    <origin xyz="0.24164 0 0" rpy="0 -1.57079632679 -3.14159265359"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.57079632679" upper="1.57079632679" effort="10" velocity="2"/>
  </joint>

  <!-- ^4T_5: rpy(0,-pi/2,pi/2)->(0,-pi/2,-pi/2), axis 翻号 -->
  <joint name="joint_5" type="revolute">
    <parent link="link_4"/>
    <child link="link_5"/>
    <origin xyz="0.0121 0.02478 0.01835" rpy="0 -1.57079632679 -1.57079632679"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.785398163397" upper="0.785398163397" effort="10" velocity="2"/>
  </joint>

  <!-- ^5T_pen_tip: xyz=[34.31,80.12,-26.72]mm (y反射), rpy(-pi/2,0,0)->(pi/2,0,0) -->
  <joint name="pen_tip_fixed_joint" type="fixed">
    <parent link="link_5"/>
    <child link="pen_tip"/>
    <origin xyz="0.03431 0.08012 -0.02672" rpy="1.57079632679 0 0"/>
  </joint>
</robot>
